// ROOT Cybersecurity POC Schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum NetworkZone {
  EXTERNAL
  DMZ
  INTERNAL
  FINANCE
}

enum AccessLevel {
  NONE
  GUEST
  USER
  SERVICE
  ADMIN
  ROOT
}

enum ServiceStatus {
  RUNNING
  STOPPED
}

enum SecurityEventCategory {
  NETWORK
  AUTH
  PROCESS
  FILESYSTEM
  WEB
  PRIVILEGE
  PERSISTENCE
  SYSTEM
}

enum SecurityEventSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ScenarioMode {
  RED
  BLUE
}

enum ScenarioState {
  SETUP
  ACTIVE
  COMPLETED
  FAILED
}

// Core scenario/game session
model Scenario {
  id        String        @id @default(cuid())
  mode      ScenarioMode
  state     ScenarioState @default(SETUP)
  createdAt DateTime      @default(now())
  startedAt DateTime?
  endedAt   DateTime?

  actors    Actor[]
  sessions  Session[]
  events    SecurityEvent[]
  machines  Machine[]
}

// A player/attacker/defender
model Actor {
  id        String   @id @default(cuid())
  name      String
  role      String   // "red_operator", "blue_operator"

  scenario  Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  scenarioId String

  sessions  Session[]
  events    SecurityEvent[]

  @@index([scenarioId])
}

// Network machines (hosts)
model Machine {
  id       String      @id @default(cuid())
  hostname String
  ip       String
  zone     NetworkZone
  os       String

  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  scenarioId String

  users       User[]
  services    Service[]
  files       File[]
  processes   Process[]
  sessions    Session[]
  persistence Persistence[]

  sourceConnections NetworkConnection[] @relation("source")
  targetConnections NetworkConnection[] @relation("target")

  networkRules NetworkRule[]

  eventsAsSource SecurityEvent[] @relation("sourceOf")
  eventsAsTarget SecurityEvent[] @relation("targetOf")

  @@unique([scenarioId, hostname])
  @@unique([scenarioId, ip])

  @@index([scenarioId])
}

// Users on machines
model User {
  id        String      @id @default(cuid())
  username  String
  role      String      // "admin", "deploy", "www-data", "finance", etc

  machine   Machine     @relation(fields: [machineId], references: [id], onDelete: Cascade)
  machineId String

  password  String?     // hashed, for internal sim use
  groups    String[]    // JSON array
  privilege AccessLevel @default(USER)

  sessions  Session[]

  @@unique([machineId, username])
  @@index([machineId])
}

// Services running on machines
model Service {
  id              String        @id @default(cuid())
  name            String
  port            Int
  protocol        String        // "tcp", "udp"
  runningAsUser   String        // username reference
  status          ServiceStatus @default(RUNNING)

  machine         Machine       @relation(fields: [machineId], references: [id], onDelete: Cascade)
  machineId       String

  exposedZones    String[]      // JSON array of NetworkZone
  metadata        String?       // JSON

  @@index([machineId])
}

// Files on machines
model File {
  id        String   @id @default(cuid())
  path      String
  owner     String   // username
  group     String?
  contents  String?  // for small files

  machine   Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  machineId String

  permissions String // e.g., "644", "755"
  isSecret  Boolean @default(false)

  @@unique([machineId, path])
  @@index([machineId])
}

// Running processes
model Process {
  id        String   @id @default(cuid())
  name      String
  pid       Int
  runningAs String   // username

  machine   Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  machineId String

  createdAt DateTime @default(now())

  @@index([machineId])
}

// Active sessions (player access to machines)
model Session {
  id           String       @id @default(cuid())
  actor        Actor?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId      String?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String

  machine      Machine      @relation(fields: [machineId], references: [id], onDelete: Cascade)
  machineId    String

  privilege    AccessLevel
  sourceMachineId String?

  scenario     Scenario     @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  scenarioId   String

  createdAt    DateTime     @default(now())
  active       Boolean      @default(true)

  @@index([machineId])
  @@index([actorId])
  @@index([scenarioId])
}

// Network connections between machines
model NetworkConnection {
  id           String   @id @default(cuid())
  source       Machine  @relation("source", fields: [sourceMachineId], references: [id], onDelete: Cascade)
  sourceMachineId String

  target       Machine  @relation("target", fields: [targetMachineId], references: [id], onDelete: Cascade)
  targetMachineId String

  port         Int
  protocol     String   // "tcp", "udp"
  allowed      Boolean  @default(true)

  @@unique([sourceMachineId, targetMachineId, port])
  @@index([targetMachineId])
}

// Network firewall rules
model NetworkRule {
  id              String   @id @default(cuid())
  sourceZone      String   // "*" or zone name
  targetMachine   Machine  @relation(fields: [targetMachineId], references: [id], onDelete: Cascade)
  targetMachineId String

  port            Int
  allow           Boolean  @default(true)

  @@index([targetMachineId])
}

// Security events for logging and detection
model SecurityEvent {
  id           String                  @id @default(cuid())
  timestamp    DateTime                @default(now())

  actor        Actor?                  @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId      String?

  sourceMachine Machine?               @relation("sourceOf", fields: [sourceMachineId], references: [id], onDelete: SetNull)
  sourceMachineId String?

  targetMachine Machine?               @relation("targetOf", fields: [targetMachineId], references: [id], onDelete: SetNull)
  targetMachineId String?

  userId      String?

  scenario    Scenario                @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  scenarioId  String

  category    SecurityEventCategory
  action      String

  visibleToRed Boolean @default(true)
  visibleToBlue Boolean @default(true)
  visibleInReplay Boolean @default(true)

  severity    SecurityEventSeverity
  metadata    String?   // JSON

  @@index([scenarioId])
  @@index([sourceMachineId])
  @@index([targetMachineId])
}

// Persistence artifacts (agents, backdoors, etc)
model Persistence {
  id                  String   @id @default(cuid())
  machine             Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  machineId           String

  type                String   // "remote_agent"
  beaconIntervalSeconds Int   @default(30)
  active              Boolean  @default(true)

  hasProcess          Boolean  @default(true)
  hasStartupEntry     Boolean  @default(true)
  hasOutboundConnection Boolean @default(true)

  createdAt           DateTime @default(now())

  @@index([machineId])
}
